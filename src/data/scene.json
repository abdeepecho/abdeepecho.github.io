  "contour": {
    "_說明": "背景的聲納等高線海溝（src/scripts/contour-trench.js）。單位是場景裡的長度，沒有真實尺寸；先小幅調整再看效果。",
    "terrain": {
      "_說明": "slope：溝底往前每 1 單位下降多少（越大越陡地往下沉）。wallHeight：岩壁高度。rimDistance：中線到溝緣的距離（越小岩壁越陡）。plainSlope：溝緣外海床平原的坡度。meander：海溝左右蜿蜒的幅度（大、小兩種彎）。widthVariation：海溝寬窄變化（0–0.5）。ridges：岩壁稜線起伏（大、中、細三層）。",
      "slope": 0.5,
      "wallHeight": 24,
      "rimDistance": 23,
      "plainSlope": 0.16,
      "meander": [
        9,
        3.2
      ],
      "widthVariation": 0.22,
      "ridges": [
        3.4,
        1.5,
        0.5
      ]
    },
    "camera": {
      "_說明": "travel：從海面捲到海溝底，鏡頭往前走多遠。diveEnd：捲到哪裡（0–1）完成「從上方俯瞰 → 潛入溝內」。heightStart/heightEnd：鏡頭離溝底的高度。pitchStart/pitchEnd：往下看的角度（弧度）。focal：鏡頭焦距（越大越窄、越近）。follow：捲動時鏡頭跟上的速度。",
      "travel": 250,
      "diveEnd": 0.42,
      "heightStart": 42,
      "heightEnd": 8,
      "pitchStart": 0.78,
      "pitchEnd": 0.4,
      "focal": 0.95,
      "follow": 0.08
    },
    "lines": {
      "_說明": "spacing：等高線間距（越小越密）。opacity：線的亮度。deepDim：越深越暗的程度（0–1）。width：線寬（px）。farDistance：畫到多遠。sampleStep：每條線的取樣間距（越小越平滑、越耗效能）。",
      "spacing": 1.5,
      "opacity": 0.4,
      "deepDim": 0.5,
      "width": 1.1,
      "farDistance": 95,
      "sampleStep": 0.8
    },
    "echo": {
      "_說明": "聲納回聲：每隔幾秒一道沿海溝往前掃的亮帶。",
      "everySeconds": 9,
      "opacity": 0.3
    },
    "fog": {
      "_說明": "海溝遠端的霧：radius 相對畫面短邊，strength 0–1。",
      "radius": 0.3,
      "strength": 0.7
    },
    "clear": {
      "_說明": "文字與圖片後方的留白：這些區塊後面的等高線會淡出，不加暗色底。selector：哪些區塊（CSS 選擇器）。strength：淡出程度（0 不處理，1 完全清空）；手機文字幾乎佔滿畫面，所以另用 strengthMobile。padding：往外多留多少（px）。feather：邊緣柔和的範圍（px）。首頁開場的標誌與服務項目不在其中，讓海溝完整露出。",
      "selector": "[data-clear], .work-card, .award-rows, .steps, .faq, .inquiry, .contact-side, .filters, .depth-meter",
