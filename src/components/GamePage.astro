---
// 遊戲作品頁（各語言共用）：/games/<slug>/、/en/games/<slug>/，資料來自 src/data/games.json
// 順序：開場（標題、一句話、Steam / Discord、主視覺）→ 預告片 → 故事 → 遊戲特色 → 截圖 → 獲獎 → 下載與返回
// 背景是固定深度的聲納等高線海溝；文字與圖片不疊在一起，也不加暗色底，靠 data-clear 讓後方的線淡出
// Steam 與 Discord 屬於遊戲，只出現在這一頁
import BaseLayout from '../layouts/BaseLayout.astro';
import ContourBackground from './ContourBackground.astro';
import TrailerPlayer from './TrailerPlayer.astro';
import Gallery from './Gallery.astro';
import { t, pick, localePath } from '../i18n/index.js';
interface Props { lang: string; game: any }
const { lang, game } = Astro.props;
const S = game.screenshots;
const imgSrc = (name: string, w: number) => `${S.dir}${name}-${w}.webp`;
const srcset = (name: string, widths: number[] = S.widths) => widths.map((w: number) => `${imgSrc(name, w)} ${w}w`).join(', ');
const otherLang = lang === 'en' ? 'zh-Hant' : 'en';
const title = pick(game.title, lang);
const K = game.keyart;
const kWidths: number[] = K.widths ?? S.widths;
const kPortrait = K.size[1] > K.size[0];   // 直式海報：右欄變窄，圖片依原比例
const awards = game.awards ?? [];
const topAward = awards.find((a: any) => a.kind === 'win') ?? awards[0];
const newTab = t(lang, 'common.newTab');
---
<BaseLayout
  lang={lang}
  path={`/games/${game.slug}/`}
  title={pick(game.meta.title, lang)}
  description={pick(game.meta.description, lang)}
  ogImage={game.ogImage}
  bodyClass="page-game"
>
  <ContourBackground slot="before-main" at={0.75} />

  <div class="game" style={`--game-accent: ${game.accent}`}>
    <section class="gp-hero" aria-labelledby="game-title">
      <div class:list={['gp-hero-inner', { 'is-portrait': kPortrait }]}>
        <div class="gp-hero-text" data-clear>
          <p class="game-status"><span class="lure-dot" aria-hidden="true"></span>{t(lang, 'game.status')}</p>
          <h1 class="game-title" id="game-title">{title}</h1>
          <p class="game-alt" lang={otherLang}>{pick(game.altTitle, lang)}</p>
          <p class="lead game-tagline">{pick(game.tagline, lang)}</p>
          <div class="actions">
            <a class="btn btn-lure" href={game.steamUrl} target="_blank" rel="noopener">{t(lang, 'cta.demo')}<span class="visually-hidden">{newTab}</span></a>
            <a class="btn" href={game.steamUrl} target="_blank" rel="noopener">{t(lang, 'cta.wishlist')}<span class="visually-hidden">{newTab}</span></a>
          </div>
          {game.discordUrl && <a class="text-link gp-discord" href={game.discordUrl} target="_blank" rel="noopener">{t(lang, 'cta.discord')}<span class="visually-hidden">{newTab}</span></a>}
          {topAward && (
            <p class="gp-hero-award"><a class="text-link" href="#gp-awards">{t(lang, 'game.awardsNote', { year: topAward.year, name: pick(topAward.name, lang), n: awards.length, more: awards.length - 1 })}</a></p>
          )}
        </div>
        <figure class="gp-keyart" data-clear>
          <img src={imgSrc(K.image, kWidths[0])} srcset={srcset(K.image, kWidths)} sizes={kPortrait ? '(max-width: 900px) 280px, 440px' : '(max-width: 900px) 100vw, 680px'} width={K.size[0]} height={K.size[1]} fetchpriority="high" decoding="async" alt={pick(K.alt, lang)} />
        </figure>
      </div>
    </section>

    <section class="section gp-trailer" aria-labelledby="trailer-title">
      <div class="section-inner">
        <div class="section-head" data-clear><h2 class="h2" id="trailer-title">{t(lang, 'trailer.title')}</h2></div>
        <div class="section-body" data-clear>
          <TrailerPlayer lang={lang} game={game} />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="story-title">
      <div class="section-inner gp-story">
        <div class="gp-story-text" data-clear>
          <h2 class="h2" id="story-title">{t(lang, 'story.title')}</h2>
          <div class="story">
            {pick(game.story, lang).map((p: string) => <p>{p}</p>)}
          </div>
          <p class="small dim note">{pick(game.storyNote, lang)}</p>
        </div>
        <div class="gp-side">
          <dl class="rows info" data-clear>
            {game.info.map((row: any) => (
              <div class="row"><dt class="small dim">{t(lang, row.key)}</dt><dd>{pick(row.value, lang)}</dd></div>
            ))}
          </dl>
          {game.music?.length > 0 && (
            <div class="music" data-clear>
              <h3 class="h3">{t(lang, 'ost.title')}</h3>
              <p class="small dim">{t(lang, 'ost.note')}</p>
              <ol class="rows music-list">
                {game.music.map((m: any) => (
                  <li><a href={m.url} target="_blank" rel="noopener"><span lang="en">{m.title}</span><span class="dim">{m.time}</span><span class="visually-hidden">{newTab}</span></a></li>
                ))}
              </ol>
              {game.musicMoreUrl && <a class="text-link music-more" href={game.musicMoreUrl} target="_blank" rel="noopener">{t(lang, 'ost.more')}<span class="visually-hidden">{newTab}</span></a>}
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="features-title">
      <div class="section-inner">
        <div class="section-head" data-clear><h2 class="h2" id="features-title">{t(lang, 'feat.title')}</h2></div>
        <ol class="section-body features">
          {game.features.map((f: any, i: number) => (
            <li class="feature">
              {f.image && (
                <figure class="feature-img" data-clear>
                  <img src={imgSrc(f.image, S.widths[0])} srcset={srcset(f.image)} sizes="(max-width: 900px) 100vw, 640px" width={S.widths[0]} height={Math.round(S.widths[0] * 9 / 16)} loading="lazy" decoding="async" alt={pick(f.alt, lang)} />
                </figure>
              )}
              <div class="feature-text" data-clear>
                <span class="feature-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="h3">{pick(f.title, lang)}</h3>
                <p>{pick(f.desc, lang)}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="gallery-title">
      <div class="section-inner">
        <div class="section-head" data-clear><h2 class="h2" id="gallery-title">{t(lang, 'gallery.title')}</h2></div>
        <Gallery lang={lang} shots={S} />
      </div>
    </section>

    {awards.length > 0 && (
      <section class="section" id="gp-awards" aria-labelledby="gp-awards-title">
        <div class="section-inner">
          <div class="section-head" data-clear><h2 class="h2" id="gp-awards-title">{t(lang, 'awards.title')}</h2></div>
          <ul class="section-body rows gp-awards" data-clear>
            {awards.map((a: any) => (
              <li class="gp-award">
                <span class="gp-year">{a.year}</span>
                <h3 class="h3" lang={/^[\x00-\x7F]+$/.test(pick(a.name, lang)) ? 'en' : undefined}>{pick(a.name, lang)}</h3>
                <p class:list={['gp-result', a.kind === 'win' ? 'is-win' : 'dim']}>{pick(a.result, lang)}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="section gp-end" aria-labelledby="end-title">
      <div class="section-inner">
        <div class="section-head" data-clear>
          <h2 class="h2" id="end-title">{t(lang, 'game.cta.title')}</h2>
          <p class="lead">{t(lang, 'game.cta.lead')}</p>
        </div>
        <div class="section-body" data-clear>
          <div class="actions">
            <a class="btn btn-lure" href={game.steamUrl} target="_blank" rel="noopener">{t(lang, 'cta.demo')}<span class="visually-hidden">{newTab}</span></a>
            <a class="btn" href={game.steamUrl} target="_blank" rel="noopener">{t(lang, 'cta.wishlist')}<span class="visually-hidden">{newTab}</span></a>
            {game.discordUrl && <a class="btn" href={game.discordUrl} target="_blank" rel="noopener">{t(lang, 'cta.discord')}<span class="visually-hidden">{newTab}</span></a>}
          </div>
          <nav class="gp-studio" aria-label={t(lang, 'game.more')}>
            <p class="dim">{t(lang, 'game.studio')}</p>
            <a class="text-link" href={localePath(lang, '/works/')}>{t(lang, 'back')}</a>
            <a class="text-link" href={`${localePath(lang, '/')}#contact`}>{t(lang, 'game.contact')}</a>
          </nav>
        </div>
      </div>
    </section>
  </div>

</BaseLayout>

<style>
  .game { position: relative; z-index: 2; }

  /* ---- 開場：左邊標題與行動，右邊主視覺；文字不壓在圖上 ---- */
  .gp-hero { padding: calc(var(--header-h) + var(--space-8)) var(--gutter) 0; }
  .gp-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: center;
    max-width: var(--content-max);
    margin-inline: auto;
  }
  .game-status { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--fs-small); font-weight: var(--fw-ui); color: var(--lure); }
  .lure-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--lure); }
  /* 遊戲名稱是這一頁的開場大標，使用 display 字級 */
  .game-title {
    margin-top: var(--space-4);
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: var(--fs-display);
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-wrap: balance;
  }
  .game-title:lang(en) { letter-spacing: 0.01em; }
  .game-alt { margin-top: var(--space-2); font-size: var(--fs-small); color: var(--ink-dim); letter-spacing: 0.12em; }
  .game-alt:lang(zh-Hant) { letter-spacing: 0.3em; }
  .game-tagline { margin-top: var(--space-5); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-6); }
  .gp-discord { margin-top: var(--space-3); }
  .gp-hero-award { margin-top: var(--space-6); padding-top: var(--space-3); border-top: 1px solid var(--line); }
  .gp-hero-award .text-link { color: var(--ink-dim); }
  .gp-hero-award .text-link:hover { color: var(--glow); }

  .gp-keyart {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--water-hadal);
  }
  .gp-keyart img { width: 100%; height: auto; }   /* 主視覺含標題字，依原比例完整顯示不裁切 */
  .gp-hero-inner.is-portrait { grid-template-columns: minmax(0, 1fr) minmax(0, 440px); }

  /* ---- 故事與資訊 ---- */
  .gp-story { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: var(--space-8); align-items: start; }
  .story { display: grid; gap: var(--space-4); margin-top: var(--space-7); max-width: var(--measure); }
  .note { margin-top: var(--space-6); max-width: var(--measure); }
  .info { margin: calc(var(--fs-h2) * 1.35 + var(--space-7)) 0 0; }
  .info .row { display: grid; gap: var(--space-1); padding: var(--space-4) 0; }
  /* 配樂：授權音樂，連到 YouTube 試聽 */
  .music { margin-top: var(--space-7); }
  .music .small { margin-top: var(--space-1); }
  .music-list { margin-top: var(--space-3); }
  .music-list a { display: flex; justify-content: space-between; gap: var(--space-4); min-height: 44px; align-items: center; text-decoration: none; font-size: var(--fs-small); }
  .music-list a:hover { color: var(--glow); }
  .music-more { display: inline-block; margin-top: var(--space-3); font-size: var(--fs-small); }

  /* ---- 遊戲特色：圖文左右交錯 ---- */
  .features { display: grid; gap: var(--space-8); padding: 0; list-style: none; }
  .feature { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-7); align-items: center; }
  .feature:nth-child(even) { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .feature:nth-child(even) .feature-img { order: 2; }
  .feature-img { border: 1px solid var(--line); border-radius: var(--radius-sm); overflow: hidden; background: var(--water-hadal); }
  .feature-img img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .feature-num {
    display: block;
    font-family: var(--font-mark);
    font-weight: 600;
    font-size: var(--fs-small);
    letter-spacing: 0.1em;
    color: var(--game-accent);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .feature-text .h3 { margin-top: var(--space-3); }
  .feature-text p { margin-top: var(--space-3); max-width: 30em; color: var(--ink-dim); }

  /* ---- 獲獎：與首頁相同的安靜清單 ---- */
  .gp-awards { max-width: 56rem; background: var(--panel); }
  .gp-award {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 12rem);
    gap: var(--space-2) var(--space-5);
    align-items: baseline;
    padding: var(--space-5);
  }
  .gp-year { font-family: var(--font-mark); font-weight: 600; font-size: var(--fs-small); color: var(--ink-dim); font-variant-numeric: lining-nums tabular-nums; }
  .gp-result { text-align: right; }
  .is-win { color: var(--lure); }

  /* ---- 結尾：再次下載、回到工作室 ---- */
  .gp-end .actions { margin-top: 0; }
  .gp-studio { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--space-5); margin-top: var(--space-7); padding-top: var(--space-5); border-top: 1px solid var(--line); max-width: 46rem; }
  .gp-studio p { margin-right: auto; font-size: var(--fs-small); }

  @media (max-width: 900px) {
    .gp-hero-inner, .gp-hero-inner.is-portrait { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .gp-keyart { order: -1; }
    .is-portrait .gp-keyart { width: min(72%, 280px); justify-self: center; }   /* 手機：海報不佔滿，標題與按鈕能在第一屏出現 */
    .gp-story { grid-template-columns: minmax(0, 1fr); gap: var(--space-7); }
    .info { margin-top: 0; }
    .feature, .feature:nth-child(even) { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
    .feature:nth-child(even) .feature-img { order: 0; }
  }
  @media (max-width: 760px) {
    .gp-hero { padding-top: calc(var(--header-h) + var(--space-5)); }
    .gp-award { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); padding: var(--space-5) var(--space-4); }
    .gp-result { text-align: left; }
    .actions .btn { flex: 1 1 100%; }
    .gp-studio p { flex-basis: 100%; }
  }
</style>
