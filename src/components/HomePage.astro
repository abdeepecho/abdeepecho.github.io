---
// 首頁（中英文共用）：往下捲動就是往海溝下潛，每個區塊是一個深度帶，各有自己的背景照片
import site from '../data/site.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import DepthBackground from './DepthBackground.astro';
import DepthMeter from './DepthMeter.astro';
import HeroSection from './sections/HeroSection.astro';
import AboutSection from './sections/AboutSection.astro';
import ServicesSection from './sections/ServicesSection.astro';
import WorksSection from './sections/WorksSection.astro';
import AwardsSection from './sections/AwardsSection.astro';
import ProcessFaqSection from './sections/ProcessFaqSection.astro';
import ContactSection from './sections/ContactSection.astro';
import { t } from '../i18n/index.js';
interface Props { lang: string }
const { lang } = Astro.props;
---
<BaseLayout lang={lang} path="/" title={t(lang, 'meta.home.title')} description={t(lang, 'meta.home.desc')} isHome bodyClass="page-home">
  <script is:inline slot="head-early">
    /* 開場判斷：第一次造訪、沒有指定區塊、沒有減少動態 → 播放聲納開場；4 秒內主程式沒接手就直接顯示內容 */
    (function () {
      var d = document.documentElement, seen = null;
      try { seen = window.localStorage.getItem('deepecho-intro-seen'); } catch (e) {}
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!seen && !reduce && !window.location.hash) {
        d.classList.add('intro-pending');
        setTimeout(function () {
          if (d.classList.contains('intro-pending')) { d.classList.remove('intro-pending'); d.classList.add('intro-done', 'intro-late'); }
        }, 4000);
      } else {
        d.classList.add('intro-done', 'intro-late');
      }
    })();
  </script>

  <Fragment slot="before-main">
    <DepthBackground />
    <div class="torch-light" data-torch-light aria-hidden="true"></div>
    <canvas class="particles" data-trench aria-hidden="true"></canvas>
    <div class="torch-veil" data-torch aria-hidden="true"></div>
    <DepthMeter lang={lang} />
  </Fragment>

  <HeroSection lang={lang} />
  <AboutSection lang={lang} />
  <ServicesSection lang={lang} />
  <WorksSection lang={lang} />
  <AwardsSection lang={lang} />
  {site.commissionsOpen && <ProcessFaqSection lang={lang} />}
  <ContactSection lang={lang} />
</BaseLayout>

<script>
  import '../scripts/home.js';
</script>

<style is:global>
  .page-home main { position: relative; }
  .particles {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  /* 潛水燈：在照片上局部提亮（越深越明顯），燈外依深度遮暗 */
  .torch-light {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    mix-blend-mode: screen;
    background: radial-gradient(circle var(--torch-r, 300px) at var(--tx, 50%) var(--ty, 40%), rgba(var(--torch-rgb, 190, 236, 255), var(--light, 0)) 0%, rgba(var(--torch-rgb, 190, 236, 255), 0) 70%);
  }
  .torch-veil {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(circle var(--torch-r, 300px) at var(--tx, 50%) var(--ty, 40%), rgba(1, 7, 14, 0) 0%, rgba(1, 7, 14, 0) 35%, rgba(1, 7, 14, var(--dark, 0)) 100%);
  }
  @media (max-width: 760px) { .torch-veil, .torch-light { --torch-r: 200px; } }

  /* 開場：先全黑，聲納光環掃過時照出背景照片 */
  html.intro-pending .depth-bg { opacity: 0; }
  html.intro-running .depth-bg {
    -webkit-mask-image: radial-gradient(circle at var(--ring-cx, 50%) var(--ring-cy, 40%), rgba(0, 0, 0, var(--bg-after, 0)) calc(var(--bg-r, 0px) - 280px), #000 calc(var(--bg-r, 0px) - 40px), rgba(0, 0, 0, var(--bg-outer, 0)) var(--bg-r, 0px));
    mask-image: radial-gradient(circle at var(--ring-cx, 50%) var(--ring-cy, 40%), rgba(0, 0, 0, var(--bg-after, 0)) calc(var(--bg-r, 0px) - 280px), #000 calc(var(--bg-r, 0px) - 40px), rgba(0, 0, 0, var(--bg-outer, 0)) var(--bg-r, 0px));
  }
  html.intro-pending .site-header,
  html.intro-running .site-header,
  html.intro-pending .depth-meter,
  html.intro-running .depth-meter { opacity: 0; pointer-events: none; }
</style>
