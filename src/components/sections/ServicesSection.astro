---
// 200 m 服務：四項服務像岩層一樣疊在岩壁上，不用卡片格線
import site from '../../data/site.json';
import { t } from '../../i18n/index.js';
import Sounding from '../Sounding.astro';
interface Props { lang: string }
const { lang } = Astro.props;
// 圖示沿用現行網站的線條圖示
const icons: Record<string, string> = {
  gamepad: '<rect x="2.5" y="7" width="19" height="11" rx="5.5"/><path d="M7.5 10.5v4M5.5 12.5h4"/><circle cx="15.5" cy="11.3" r=".8"/><circle cx="17.8" cy="13.7" r=".8"/>',
  cube: '<path d="M12 2.8 20 7.4v9.2l-8 4.6-8-4.6V7.4z"/><path d="M4 7.4l8 4.6 8-4.6M12 12v9.2"/>',
  orbit: '<circle cx="12" cy="12" r="4.2"/><ellipse cx="12" cy="12" rx="9.5" ry="3.8" transform="rotate(-24 12 12)"/><circle cx="19.6" cy="8.4" r=".9"/>',
  screen: '<rect x="3" y="4.5" width="18" height="12" rx="1"/><path d="M10.5 8.1l4 2.4-4 2.4z"/><path d="M8 20h8M12 16.5V20"/>',
};
---
<section class="band services" id="services" data-depth="200" data-zone="twilight" aria-labelledby="services-title">
  <Sounding lang={lang} depth={200} zone="twilight" />
  <div class="band-body">
    <h2 class="h2" id="services-title">{t(lang, 'svc.title')}</h2>
    <p class="lead">{t(lang, 'svc.intro')}</p>
    {!site.commissionsOpen && (
      <p class="paused-note" role="note"><span class="paused-dot" aria-hidden="true"></span>{t(lang, 'status.paused')}</p>
    )}
    <ul class="svc-list">
      {site.services.map((s) => (
        <li class="svc">
          <svg class="svc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]}></svg>
          <h3 class="svc-title">{t(lang, `${s.key}.title`)}</h3>
          <p class="svc-alt" lang={lang === 'en' ? 'zh-Hant' : 'en'}>{t(lang, `${s.key}.alt`)}</p>
          <p class="svc-desc">{t(lang, `${s.key}.desc`)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services .lead { margin-top: var(--space-5); }
  .svc-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) clamp(var(--space-6), 6vw, var(--space-9));
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
    max-width: 58rem;
  }
  /* 第二欄往下錯開，像不規則的岩層 */
  .svc:nth-child(even) { transform: translateY(var(--space-8)); }
  .svc {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: baseline;
    text-shadow: var(--text-shadow-body);
  }
  .svc-icon { grid-row: 1 / span 3; width: 30px; height: 30px; color: var(--glow); align-self: start; margin-top: 0.15em; }
  .svc-title { font-family: var(--font-heading); font-weight: 900; font-size: var(--fs-xl); letter-spacing: 0.08em; line-height: 1.35; }
  .svc-title:lang(en) { letter-spacing: 0.01em; }
  .svc-alt { font-size: var(--fs-sm); color: var(--ink); letter-spacing: 0.04em; }
  .svc-desc { margin-top: var(--space-3); max-width: 24em; color: var(--ink); }
  @media (max-width: 760px) {
    .svc-list { grid-template-columns: minmax(0, 1fr); gap: var(--space-7); margin-top: var(--space-7); }
    .svc:nth-child(even) { transform: none; }
  }
</style>
