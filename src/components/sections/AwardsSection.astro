---
// 4,000 m 獲獎：安靜的清單，一列一個獎項，以髮絲線分隔
// 得獎與入圍只差在結果文字的顏色（得獎 --lure，入圍 --ink-dim）；只放已查證的獎項
import games from '../../data/games.json';
import { t, pick } from '../../i18n/index.js';
import Sounding from '../Sounding.astro';
interface Props { lang: string }
const { lang } = Astro.props;
const awards = games.flatMap((g) => (g.awards ?? []).map((a) => ({ ...a, game: pick(g.title, lang) })));
const work = (name: string) => (lang === 'zh-Hant' ? `《${name}》` : name);
---
<section class="section awards" id="awards" data-depth="4000" data-zone="abyss" aria-labelledby="awards-title">
  <div class="section-inner">
    <div class="section-head scrim">
      <Sounding lang={lang} depth={4000} zone="abyss" />
      <h2 class="h2" id="awards-title">{t(lang, 'awards.title')}</h2>
      <p class="lead">{t(lang, 'awards.intro')}</p>
    </div>
    <ul class="section-body rows award-rows">
      {awards.map((a) => (
        <li class="award-row">
          <span class="award-year">{a.year}</span>
          <h3 class="h3 award-name" lang={/^[\x00-\x7F]+$/.test(pick(a.name, lang)) ? 'en' : undefined}>{pick(a.name, lang)}</h3>
          <p class="award-result">
            <span class:list={['result', a.kind === 'win' ? 'is-win' : 'is-selection']}>{pick(a.result, lang)}</span>
            <span aria-hidden="true"> · </span>
            <span>{work(a.game)}</span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .award-rows { max-width: 56rem; background: var(--panel); }
  .award-row {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 15rem);
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-5) var(--space-5);
  }
  .award-year { font-family: var(--font-mark); font-weight: 600; font-size: var(--fs-small); color: var(--ink-dim); font-variant-numeric: lining-nums tabular-nums; }
  .award-result { color: var(--ink-dim); text-align: right; }
  .result.is-win { color: var(--lure); }
  @media (max-width: 760px) {
    .award-row { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); padding: var(--space-5) var(--space-4); }
    .award-result { text-align: left; }
  }
</style>
