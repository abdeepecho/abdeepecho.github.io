---
// 1,000 m 作品：作品卡片（最多 6 張），超過時顯示「所有作品」
import { allWorks as games } from '../../data/catalog.js';
import { t, localePath } from '../../i18n/index.js';
import Sounding from '../Sounding.astro';
import WorksGrid from '../WorksGrid.astro';
interface Props { lang: string }
const { lang } = Astro.props;
const LIMIT = 6;
---
<section class="section works" id="works" data-depth="1000" data-zone="midnight" aria-labelledby="works-title">
  <div class="section-inner">
    <div class="section-head" data-clear>
      <Sounding lang={lang} depth={1000} zone="midnight" />
      <h2 class="h2" id="works-title">{t(lang, 'works.title')}</h2>
      <p class="lead">{t(lang, 'works.intro')}</p>
    </div>
    <div class="section-body">
      <WorksGrid lang={lang} games={games} limit={LIMIT} />
      {games.length > LIMIT && (
        <a class="text-link works-all" href={localePath(lang, '/works/')}>{t(lang, 'works.all')}</a>
      )}
    </div>
  </div>
</section>

<style>
  .works-all { margin-top: var(--space-5); }
</style>
