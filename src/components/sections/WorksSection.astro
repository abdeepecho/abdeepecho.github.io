---
// 1,000 m 作品：大型遊戲標題、上架狀態、簡介、兩個按鈕；右側是圓形舷窗
import games from '../../data/games.json';
import site from '../../data/site.json';
import { t, pick, localePath } from '../../i18n/index.js';
import Sounding from '../Sounding.astro';
import Porthole from '../Porthole.astro';
interface Props { lang: string }
const { lang } = Astro.props;
const game = games.find((g) => g.slug === site.featuredGame) ?? games[0];
const otherLang = lang === 'en' ? 'zh-Hant' : 'en';
---
<section class="band works" id="works" data-depth="1000" data-zone="midnight" aria-labelledby="works-title">
  <Sounding lang={lang} depth={1000} zone="midnight" />
  <div class="band-body">
    <h2 class="h2" id="works-title">{t(lang, 'works.title')}</h2>
    <article class="game" aria-labelledby="game-title">
      <div class="game-text">
        <p class="game-status"><span class="lure-dot" aria-hidden="true"></span>{t(lang, 'game.status')}</p>
        <h3 class="game-title" id="game-title">{pick(game.title, lang)}</h3>
        <p class="game-alt" lang={otherLang}>{pick(game.altTitle, lang)}</p>
        <p class="game-tagline">{pick(game.tagline, lang)}</p>
        <div class="game-actions">
          <a class="btn btn-primary" href={localePath(lang, `/games/${game.slug}/`)}>{t(lang, 'works.more')}</a>
          <a class="btn" href={game.steamUrl} target="_blank" rel="noopener">{t(lang, 'works.steam')}<span class="visually-hidden">{t(lang, 'common.newTab')}</span></a>
        </div>
      </div>
      <Porthole lang={lang} game={game} />
    </article>

    <div class="music">
      <h3 class="music-title">{t(lang, 'ost.title')}</h3>
      <ol class="music-list">
        {game.music.map((m) => (
          <li>
            <a href={m.url} target="_blank" rel="noopener">
              <span class="music-name" lang="en">{m.title}</span>
              <span class="music-time">{m.time}</span>
              <span class="visually-hidden">{t(lang, 'common.newTab')}</span>
            </a>
          </li>
        ))}
      </ol>
      <a class="music-more" href={game.musicMoreUrl} target="_blank" rel="noopener">{t(lang, 'ost.more')}<span class="visually-hidden">{t(lang, 'common.newTab')}</span></a>
    </div>
  </div>
</section>

<style>
  .game {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(var(--space-6), 5vw, var(--space-9));
    margin-top: var(--space-7);
  }
  .game-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--lure);
    letter-spacing: 0.08em;
  }
  .lure-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--lure); }
  .game-title {
    margin-top: var(--space-4);
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: var(--fs-display);
    line-height: 1.02;
    letter-spacing: 0.08em;
    color: #F2FAFC;
  }
  .game-title:lang(en) { font-size: clamp(2.75rem, 1.4rem + 5vw, 5.25rem); letter-spacing: 0; line-height: 1.05; }
  .game-alt { margin-top: var(--space-3); font-family: var(--font-mark); font-size: var(--fs-lg); letter-spacing: 0.22em; color: var(--ink-dim); }
  .game-alt:lang(zh-Hant) { font-family: var(--font-heading); font-weight: 900; letter-spacing: 0.3em; }
  .game-tagline { margin-top: var(--space-5); max-width: 26em; font-size: var(--fs-md); color: var(--ink); text-shadow: var(--text-shadow-body); }
  .game-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  .music { margin-top: var(--space-9); max-width: 46rem; }
  .music-title { font-family: var(--font-heading); font-weight: 900; font-size: var(--fs-md); letter-spacing: 0.1em; }
  .music-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-6);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: track;
  }
  .music-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 44px;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--fs-sm);
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  .music-list a:hover { color: var(--glow); border-color: var(--glow-line); }
  .music-time { color: var(--ink-dim); font-variant-numeric: tabular-nums; }
  .music-more { display: inline-flex; align-items: center; min-height: 44px; margin-top: var(--space-3); color: var(--ink-dim); font-size: var(--fs-sm); }
  .music-more:hover { color: var(--glow); }

  @media (max-width: 960px) {
    .game { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .music-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
