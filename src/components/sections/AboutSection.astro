---
// 0 m 關於：兩三句介紹、團隊分工與使用工具（分工清單在 site.json 的 team）
import site from '../../data/site.json';
import { t } from '../../i18n/index.js';
import Sounding from '../Sounding.astro';
interface Props { lang: string }
const { lang } = Astro.props;
---
<section class="section about" id="about" data-depth="0" data-zone="surface" aria-labelledby="about-title">
  <div class="section-inner">
    <div class="section-head" data-clear>
      <Sounding lang={lang} depth={0} zone="surface" />
      <h2 class="h2" id="about-title">{t(lang, 'about.title')}</h2>
      <p class="lead">{t(lang, 'about.body')}</p>
      <p class="small about-meta">{t(lang, 'about.meta')}</p>
    </div>
    <div class="section-body team-block" data-clear>
      <h3 class="h3">{t(lang, 'team.title')}</h3>
      <p class="team-lead dim">{t(lang, 'team.lead')}</p>
      <ul class="rows team">
        {site.team.map((key) => <li>{t(lang, key)}</li>)}
      </ul>
    </div>
    <div class="section-body tools-block" data-clear>
      <h3 class="h3">{t(lang, 'tools.title')}</h3>
      <ul class="tools">
        {site.tools.map((tool) => (
          <li><span class="tool-name" lang="en">{tool.name}</span><span class="small dim">{t(lang, tool.key)}</span></li>
        ))}
      </ul>
      <p class="tools-ai dim">{t(lang, 'tools.ai')}</p>
    </div>
  </div>
</section>

<style>
  .about-meta { margin-top: var(--space-4); }
  .team-block, .tools-block { max-width: 46rem; }
  .team-lead { margin-top: var(--space-3); }
  .team { margin: var(--space-4) 0 0; }
  .team li { padding: var(--space-3) 0; }
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-4) var(--space-6);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .tools li { display: flex; flex-direction: column; }
  .tool-name { font-weight: var(--fw-ui); }
  /* 說明使用 AI 工具輔助開發 */
  .tools-ai { margin-top: var(--space-5); max-width: var(--measure); }
</style>
