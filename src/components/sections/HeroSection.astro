---
// 0 m 開場：聲納光波照出背景海溝與工作室標誌，第二圈照出標語
import site from '../../data/site.json';
import { t } from '../../i18n/index.js';
interface Props { lang: string }
const { lang } = Astro.props;
const B = site.brand;
// 標語在逗號或句點後分成兩段，各自不斷行，避免手機上最後一個字單獨換行
const sloganParts = t(lang, 'slogan').match(/[^，。.]+[，。.]?\s*/g) ?? [t(lang, 'slogan')];
---
<section class="hero" id="top" data-depth="0" data-zone="surface">
  <div class="hero-content" data-reveal>
    <h1 class="lockup">
      <span class="lockup-art" data-logo aria-hidden="true">
        <img class="lockup-glitch" src={B.glitch} width={B.glitchSize[0]} height={B.glitchSize[1]} alt="" decoding="async" fetchpriority="high" />
        <img class="lockup-mark" src={B.mark} width={B.markSize[0]} height={B.markSize[1]} alt="" decoding="async" fetchpriority="high" />
      </span>
      <span class="wordmark" lang="en">Deep Echo</span>
      <span class="wordmark-zh" lang="zh-Hant">幽海工作室</span>
    </h1>
    <p class="slogan" data-reveal-late>{sloganParts.map((part) => <span class="slogan-part">{part}</span>)}</p>
    <p class="hero-sub" data-reveal-late>{t(lang, 'hero.sub')}</p>
  </div>
  <span class="sonar-rings" aria-hidden="true"><span class="sonar-ring"></span><span class="sonar-ring"></span></span>
  <a class="dive-cue" href="#about">
    <span>{t(lang, 'hero.dive')}</span>
    <span class="dive-line" aria-hidden="true"><span class="dive-weight"></span></span>
  </a>
  <button class="intro-skip" type="button" data-intro-skip>{t(lang, 'intro.skip')}</button>
</section>

<style>
  .hero {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-h) + var(--space-6)) var(--gutter) var(--space-8);
    text-align: center;
    overflow: hidden;
    overflow: clip;
  }
  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    --reveal: 200vmax;
  }
  /* 開場遮罩：以標誌中心為圓心，半徑由 home.js 控制；只在開場期間套用，
     否則遮罩會把下面延伸出去的柔和底色裁成方框 */
  :global(html.intro-pending) .hero-content,
  :global(html.intro-running) .hero-content {
    -webkit-mask-image: radial-gradient(circle at 50% var(--reveal-y, 35%), #000 calc(var(--reveal) - 60px), transparent var(--reveal));
    mask-image: radial-gradient(circle at 50% var(--reveal-y, 35%), #000 calc(var(--reveal) - 60px), transparent var(--reveal));
  }
  .lockup { display: flex; flex-direction: column; align-items: center; font-weight: normal; }
  .lockup-art {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(280px, 40vw, 560px);
    aspect-ratio: 1600 / 600;
  }
  .lockup-art > img { grid-area: 1 / 1; }
  .lockup-glitch { width: 100%; opacity: 0.94; }
  .lockup-mark { width: 38%; position: relative; }
  /* 字標：官方標誌組合的一部分（Cinzel 只用在這裡與水深數字） */
  .wordmark {
    margin-top: var(--space-5);
    font-family: var(--font-mark);
    font-weight: 600;
    font-size: var(--fs-h2);
    letter-spacing: 0.3em;
    padding-left: 0.3em;
    text-transform: uppercase;
    line-height: 1.1;
    color: #F4FAFC;
    text-shadow: 0 0 18px rgba(142, 240, 222, 0.16);
  }
  .wordmark-zh {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: var(--fs-body);
    letter-spacing: 0.42em;
    padding-left: 0.42em;
    line-height: 1.4;
  }
  .wordmark-zh::before, .wordmark-zh::after { content: ''; width: 2.2em; height: 1px; background: currentColor; opacity: 0.6; }
  .wordmark-zh::after { margin-left: -0.42em; }
  .slogan {
    margin-top: var(--space-7);
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: var(--fs-display);
    line-height: 1.25;
    letter-spacing: var(--ls-heading);
  }
  .slogan-part { display: inline-block; white-space: nowrap; }
  .slogan:lang(en) .slogan-part + .slogan-part { margin-left: 0.28em; }
  .hero-sub { margin-top: var(--space-4); letter-spacing: 0.1em; }
  .hero-sub:lang(en) { letter-spacing: 0.02em; }

  /* 聲納光環：以標誌中心擴散，開場時由 home.js 播放 */
  .sonar-rings { position: absolute; left: var(--ring-x, 50%); top: var(--ring-y, 35%); width: 0; height: 0; pointer-events: none; z-index: 1; }
  .sonar-ring {
    position: absolute;
    left: -50vmax;
    top: -50vmax;
    width: 100vmax;
    height: 100vmax;
    border-radius: 50%;
    border: 1.5px solid var(--glow);
    box-shadow: 0 0 24px rgba(142, 240, 222, 0.5), inset 0 0 24px rgba(142, 240, 222, 0.3);
    opacity: 0;
    transform: scale(0);
  }

  .dive-cue {
    position: absolute;
    left: 50%;
    bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--fs-small);
    font-weight: var(--fw-ui);
    letter-spacing: 0.2em;
    transition: opacity 700ms var(--ease-out);
  }
  .dive-cue:lang(en) { letter-spacing: 0.06em; }
  .dive-line { position: relative; width: 1px; height: 52px; background: linear-gradient(var(--ink), rgba(230, 242, 247, 0)); }
  .dive-weight { position: absolute; left: -3px; top: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--glow); }
  @media (prefers-reduced-motion: no-preference) {
    .dive-weight { animation: sink 2.8s var(--ease-out) infinite; }
  }
  @keyframes sink {
    0% { transform: translateY(0); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translateY(46px); opacity: 0; }
  }

  .intro-skip {
    position: fixed;
    right: var(--gutter);
    bottom: calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-plate);
    background: rgba(1, 7, 14, 0.5);
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: var(--fw-ui);
    cursor: pointer;
    display: none;
  }

  /* ---- 開場狀態（class 在 <html> 上）---- */
  :global(html.intro-pending) .hero-content,
  :global(html.intro-running) .hero-content { --reveal: 0px; }
  :global(html.intro-pending) .dive-cue,
  :global(html.intro-running) .dive-cue { opacity: 0; }
  :global(html.intro-running) .intro-skip { display: inline-flex; align-items: center; }
  :global(html.intro-pending) [data-reveal-late],
  :global(html.intro-running:not(.intro-late)) [data-reveal-late] { opacity: 0; }
  [data-reveal-late] { transition: opacity 500ms var(--ease-out); }

  @media (max-width: 560px) {
    .wordmark { letter-spacing: 0.2em; padding-left: 0.2em; }
    .wordmark-zh { letter-spacing: 0.3em; padding-left: 0.3em; }
  }
</style>
