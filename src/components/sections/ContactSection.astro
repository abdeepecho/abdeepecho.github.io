---
// 10,994 m 海溝底部：聯絡與委託表單；琥珀色按鈕是唯一的一盞燈
// 接案開關在 src/data/site.json 的 commissionsOpen；false 時隱藏表單、改顯示暫停說明
import site from '../../data/site.json';
import { t } from '../../i18n/index.js';
import Sounding from '../Sounding.astro';
import InquiryForm from '../InquiryForm.astro';
interface Props { lang: string }
const { lang } = Astro.props;
const open = site.commissionsOpen;
---
<section class="section contact" id="contact" data-depth="10994" data-zone="floor" aria-labelledby="contact-title">
  <div class="section-inner">
    <div class="section-head" data-clear>
      <Sounding lang={lang} depth={10994} zone="floor" />
      <h2 class="h2" id="contact-title">{t(lang, open ? 'contact.title' : 'contact.title.paused')}</h2>
      <p class="lead">{t(lang, open ? 'contact.lead' : 'contact.lead.paused')}</p>
      {!open && (
        <p class="paused-note" role="note"><span class="paused-dot" aria-hidden="true"></span>{t(lang, 'status.paused')}</p>
      )}
    </div>

    <div class:list={['section-body', 'contact-grid', { 'is-paused': !open }]}>
      {open && <InquiryForm lang={lang} />}
      <aside class="contact-side" aria-label={t(lang, 'contact.direct')}>
        <h3 class="side-label">{t(lang, 'contact.direct')}</h3>
        <a class:list={['btn', { 'btn-lure': !open }, 'mail-btn']} href={`mailto:${site.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"></rect><path d="M3 7l9 6 9-6"></path></svg>
          {site.email}
        </a>
        <h3 class="side-label">{t(lang, 'social.label')}</h3>
        <ul class="socials">
          {site.socials.map((s) => (
            <li><a class="text-link" href={s.url} target="_blank" rel="noopener">{s.name}<span class="visually-hidden">{t(lang, 'common.newTab')}</span></a></li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .contact-grid.is-paused { grid-template-columns: minmax(0, 1fr); }
  .contact-side { padding: var(--space-5); border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--panel); }
  .side-label { margin-top: var(--space-6); font-size: var(--fs-small); font-weight: var(--fw-ui); color: var(--ink-dim); }
  .side-label:first-child { margin-top: 0; }
  .mail-btn { margin-top: var(--space-3); max-width: 100%; padding-inline: var(--space-5); overflow-wrap: anywhere; }
  .mail-btn svg { width: 20px; height: 20px; flex: none; }
  .socials { display: grid; grid-template-columns: repeat(2, max-content); gap: 0 var(--space-7); margin: var(--space-2) 0 0; padding: 0; list-style: none; }
  .socials .text-link { font-size: var(--fs-body); font-weight: var(--fw-body); }
  @media (max-width: 960px) {
    .contact-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
