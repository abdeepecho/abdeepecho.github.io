---
// 6,000 m 合作流程與常見問題（暫停接案時整段不輸出）
// 和獲獎同樣的安靜清單；流程是真正的先後順序，所以有步驟編號
import site from '../../data/site.json';
import { t } from '../../i18n/index.js';
import Sounding from '../Sounding.astro';
interface Props { lang: string }
const { lang } = Astro.props;
---
<section class="section process" id="process" data-depth="6000" data-zone="hadal" aria-labelledby="process-title">
  <div class="section-inner">
    <div class="section-head" data-clear>
      <Sounding lang={lang} depth={6000} zone="hadal" />
      <h2 class="h2" id="process-title">{t(lang, 'proc.title')}</h2>
      <p class="lead">{t(lang, 'proc.intro')}</p>
    </div>
    <ol class="section-body rows steps">
      {site.processSteps.map((key, i) => (
        <li class="step">
          <span class="step-num" aria-hidden="true">{i + 1}</span>
          <h3 class="h3">{t(lang, `${key}.title`)}</h3>
          <p class="step-desc">{t(lang, `${key}.desc`)}</p>
        </li>
      ))}
    </ol>

    <div class="section-sub" id="faq">
      <div class="section-head" data-clear>
        <h2 class="h2">{t(lang, 'faq.title')}</h2>
        <p class="lead">{t(lang, 'faq.intro')}</p>
      </div>
      <div class="section-body rows faq" data-accordion>
        {site.faq.map((key) => (
          <details class="row faq-item">
            <summary><span class="h3">{t(lang, `${key}.q`)}</span><span class="faq-icon" aria-hidden="true"></span></summary>
            <p>{t(lang, `${key}.a`)}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .steps, .faq { max-width: 56rem; background: var(--panel); }
  .step {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    padding: var(--space-5);
  }
  .step-num { grid-row: 1 / span 2; font-size: var(--fs-small); font-weight: var(--fw-ui); color: var(--glow); line-height: 2.2; }
  .step-desc { color: var(--ink-dim); max-width: var(--measure); }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--glow); }
  .faq-icon { position: relative; flex: none; width: 14px; height: 14px; }
  .faq-icon::before, .faq-icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6.5px;
    width: 14px;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-med) var(--ease-out);
  }
  .faq-icon::after { transform: rotate(90deg); }
  .faq-item[open] .faq-icon::after { transform: rotate(0deg); }
  .faq-item p { padding: 0 var(--space-5) var(--space-5); max-width: var(--measure); color: var(--ink-dim); }
  @media (max-width: 760px) {
    .step { grid-template-columns: 2rem minmax(0, 1fr); padding: var(--space-5) var(--space-4); }
    .faq-item summary { padding-inline: var(--space-4); }
    .faq-item p { padding-inline: var(--space-4); }
  }
</style>
